module;
export module Engine.Diagnostics:Fix;

import Engine.Common;

import :Location;

export namespace hg::engine::diag {
	enum class Applicability : u8 {
		eMachineApplicable,
		eMaybeIncorrect,
		eHasPlaceholders
	};

	struct TextEdit {
		SourceSpan range;
		String replacement;
	};

	struct Fix {
		String title;
		Vector<TextEdit> edits;
		Applicability applicability;
	};
}
